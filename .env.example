# Copy this file to .env and fill in real values. Every backend/app
# environment (local, staging, each teammate's machine, production) should
# define the same set of keys so behavior doesn't silently differ between
# them - add new keys here whenever you add one to .env.

# --- Database ---
MONGO_URI=mongodb://localhost:27017/your-db-name

# --- Auth / sessions ---
JWT_SECRET=replace-with-a-long-random-string
JWT_LIFETIME=30d
SESSION_KEY=replace-with-a-long-random-string

# --- Backend's own public URL (used to build links back to itself, e.g. in
# verification/reset-password emails) ---
ORIGIN=http://localhost:7004
NODE_ENV=development

# --- Google OAuth (one shared app-wide client; see utils/passport.js) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Path or absolute URL Google redirects back to on this backend.
CALLBACK_URL=/api/v1/auth/google/callback
# Fallback frontend to send the token to when a caller of
# /api/v1/auth/google doesn't pass its own ?redirect_uri=.
REDIRECT_URL=http://localhost:3000
# Comma-separated allowlist of hostnames (or ".domain.com" for any
# subdomain) a caller-supplied redirect_uri is allowed to point at.
# NOTE: Google login (/api/v1/auth/google) does NOT use this - it accepts
# any http(s) redirect_uri with no allowlist, by explicit design choice
# (see utils/oauthRedirect.js). This list only gates
# controllers/seedbridgePayment.js's payment redirect.
ALLOWED_REDIRECT_DOMAINS=localhost,127.0.0.1

# --- Image uploads (ImageKit) ---
IMAGE_KIT_PUBLIC_KEY=
IMAGE_KIT_PRIVATE_KEY=
IMAGE_KIT_ID=
IMAGE_KIT_ENDPOINT=

# --- Clerk (alternate auth provider used by some routes) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI providers ---
HUGGINGFACE=
OPENAI_API_KEYS=
OPENROUTER_API_KEY=
# GH-GPT AI (utils/ghgptAi.js). Optional: model names, and the free keyless fallback
# (Pollinations, text-only) used when both keys fail. Set GHGPT_FREE_FALLBACK=false to disable it.
# OPENROUTER_MODEL=openai/gpt-5.6-luna-pro   (paid; set only once the OpenRouter account has credits)
# GHGPT_OPENROUTER_FREE_MODELS=openrouter/free,google/gemma-4-31b-it:free
# GEMINI_API_KEY=   (free key from aistudio.google.com; reads images and documents)
# GHGPT_IMAGE_MODEL=google/gemini-2.5-flash-image   (paid image generation; the default is free Pollinations)
OPENAI_MODEL=gpt-4o-mini
GHGPT_FREE_FALLBACK=true
GHGPT_FREE_MODEL=openai-fast
# Public GH-GPT site used in email links (localhost values fall back to the live site)
GHGPT_PUBLIC_URL=https://gh-gpt.onrender.com
AI_PROVIDER=openrouter
CLIENT_URL_AI=http://localhost:7009

# --- Email (nodemailer) ---
EMAIL_USER=
EMAIL_PASS=

# --- Reloadly (airtime/data top-up API) ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_ENV=sandbox

# --- Paystack ---
TEST_PAYSTACK_PUBLIC_KEY=
TEST_PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=/afrodatahome

# --- Africa's Talking (USSD) ---
AT_USERNAME=sandbox
AT_API_KEY=

# --- SeedBridge (farm-to-market app, namespaced under /api/v1/seedbridge/*)
# Its Paystack checkout (controllers/seedbridgePayment.js) takes the
# frontend's own callbackUrl per-request the same way Google login does,
# validated against ALLOWED_REDIRECT_DOMAINS above - so this is only used
# as a fallback when a request doesn't pass its own callbackUrl.
SEEDBRIDGE_CLIENT_URL=http://localhost:3000

# --- CleanBridge GH (waste-collection app, namespaced under /api/v1/cleanbridge/*)
# Secret required as `adminKey` when signing up with role "admin". Leave
# empty to disable admin self-signup entirely.
CLEANBRIDGE_ADMIN_SIGNUP_KEY=
# Public URL of the CleanBridge frontend - used for links in emails.
# Comma-separated emails that become CleanBridge admins when they sign in with
# Google (Google proves they own the address).
CLEANBRIDGE_ADMIN_EMAILS=
CLEANBRIDGE_CLIENT_URL=http://localhost:5173
# Email updates are sent through EMAIL_USER / EMAIL_PASS (Gmail app password) above.

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MUVIIN_API_KEY=
